<% layout("./layouts/boilerplate") %>

    <div class="form-wrap">
        <a class="back" href="/listings/<%= listing._id %>">&larr; Back to listing</a>
        <h1 class="page-title">Edit your listing</h1>
        <p class="form-lead">Update the details guests see.</p>

        <form class="form needs-validation" action="/listing/<%= listing._id %>?_method=PUT" method="POST"
            enctype="multipart/form-data" novalidate>
            <div class="field">
                <label for="title">Title</label>
                <input id="title" name="title" value="<%= listing.title %>" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please provide a valid title.
                </div>
            </div>
            <div class="field">
                <label for="description">Description</label>
                <input id="description" name="description" value="<%= listing.description %>" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please provide a valid description.
                </div>
            </div>



            <div class="field">
                <label for="image">Upload Listing Image</label>
                <input id="image" type="file" name="image" accept="image/png,image/jpeg,image/webp">
                <div class="image preview">
                    <img src="<%= listing.image.url  %>">
                </div>
                <div class="invalid-feedback">
                    Please upload a listing image.
                </div>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>

            <div class="field">
                <label for="price">Price per night</label>
                <div class="input-prefix">
                    <span>&#8377;</span>
                    <input id="price" name="price" type="number" min="0" value="<%= listing.price %>" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please provide a valid price.
                    </div>
                </div>
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="location">Location</label>
                    <input id="location" name="location" value="<%= listing.location %>" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please provide a valid location.
                    </div>
                </div>
                <div class="field">
                    <label for="country">Country</label>
                    <input id="country" name="country" value="<%= listing.country %>" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please provide a valid country.
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" href="/listings/<%= listing._id %>">Cancel</a>
                <button class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>